{
  "runtime": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "chat_endpoint": "/api/chat",
    "default_model": "qwen2.5:3b",
    "profiles": {
      "fast": {
        "model": "qwen2.5:3b",
        "temperature": 0.1,
        "max_tokens": 1024
      },
      "balanced": {
        "model": "qwen2.5:3b",
        "temperature": 0.2,
        "max_tokens": 4096
      },
      "coder": {
        "model": "qwen2.5:3b",
        "temperature": 0.1,
        "max_tokens": 4096
      }
    }
  },
  "permissions": {
    "network_default": "deny",
    "shell_default": "ask",
    "desktop_control_default": "ask",
    "memory_write_default": "ask",
    "high_impact_default": "deny"
  },
  "storage": {
    "memory_dir": "%USERPROFILE%/.local-jarvis/memory",
    "log_dir": "%USERPROFILE%/.local-jarvis/logs",
    "transcript_dir": "%USERPROFILE%/.local-jarvis/sessions",
    "artifact_dir": "%USERPROFILE%/.local-jarvis/artifacts"
  },
  "conversation": {
    "max_messages": 40
  },
  "voice": {
    "enabled": false,
    "mode": "push_to_talk",
    "stt": "local",
    "tts": "local",
    "show_transcript_before_action": true
  }
}
